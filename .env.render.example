# Modelo apenas: configure os valores reais no painel do Render, nunca no Git.
# Runtime pode usar pooling; DIRECT_URL deve ser direta para migrações.
# Host/usuário/senha abaixo são placeholders; este arquivo não cria uma conexão real.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST_NEON/BASE?sslmode=verify-full"
# DIRECT_URL pertence somente ao ambiente privado do operador de migração.
# Não configurar esse segredo no serviço web.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
HOST=0.0.0.0
NODE_ENV=production
NODE_VERSION=24.20.0
# Sem frontend autorizado: clientes sem Origin funcionam; origens de navegador são negadas.
# Quando houver frontend, substitua none pelas origens HTTPS exatas, sem caminho.
CORS_ORIGINS=none
# PORT é fornecida pelo Render. Não copie PORT=3000 do ambiente local.
# Configure um segredo aleatório de pelo menos 32 caracteres no painel.
API_WRITE_TOKEN=

# URL da aplicação aceita schema/sslmode/application_name/connect_timeout.
# Usar verify-full; não usar parâmetros de pool Prisma6 ou channel_binding de libpq.
# Medir cold start remoto antes de ajustar timeouts; não usar keepalive artificial.

