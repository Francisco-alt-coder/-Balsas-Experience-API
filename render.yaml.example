# MODELO NÃO ATIVO. Importação/criação/deploy dependem de autorização futura.
# Pressupõe que package.json esteja na raiz de um repositório dedicado a esta API.
services:
  - type: web
    name: balsas-experience-api
    runtime: node
    region: virginia
    plan: free
    autoDeployTrigger: "off"
    # Free não oferece preDeployCommand. Migrar manualmente antes do deploy autorizado.
    buildCommand: npm ci --include=dev && npm run build
    startCommand: npm start
    healthCheckPath: /health
    envVars:
      - key: NODE_VERSION
        value: 24.20.0
      - key: NODE_ENV
        value: production
      - key: HOST
        value: 0.0.0.0
      - key: DATABASE_URL
        sync: false
      - key: API_WRITE_TOKEN
        sync: false
      - key: CORS_ORIGINS
        sync: false
      - key: DB_POOL_MAX
        value: "10"
      - key: DB_CONNECTION_TIMEOUT_MS
        value: "5000"
      - key: DB_QUERY_TIMEOUT_MS
        value: "10000"
