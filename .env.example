# Copie este arquivo para .env e substitua pelos dados reais do PostgreSQL.
# Nunca publique a senha real no GitHub.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/balsas_experience?schema=public"
# Opcional localmente; no Neon, URL sem -pooler para a CLI/migrações.
DIRECT_URL=
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Gere um segredo forte em cofre/gerenciador privado, sem imprimir seu valor.
API_WRITE_TOKEN=
# Origens exatas separadas por vírgula. Obrigatório em produção.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000

# Produção remota: usar o exemplo .env.render.example e sslmode=verify-full.
# Pool/timeout são opções do driver; não usar connection_limit/pool_timeout na URL.
# Não copiar .env local para Render. DIRECT_URL pertence apenas ao operador.

