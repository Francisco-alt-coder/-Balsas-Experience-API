{
  "name": "balsas-experience-api",
  "version": "2.0.0",
  "description": "API REST de atrações turísticas de Balsas-MA com Node.js, Express, Prisma ORM e PostgreSQL",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "check": "node --check src/app.js && node --check src/routes/atracoes.routes.js && node --check src/controllers/atracoes.controller.js && node --check src/lib/prisma.js && node --check prisma/seed.js",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "node tools/seed-evidencias-ci.mjs",
    "db:sync-sequences": "node scripts/sync-sequences.mjs",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "build": "npm run prisma:generate",
    "test:lab08": "node scripts/test-lab08.mjs",
    "db:backup": "node scripts/backup-local.mjs",
    "db:test:prepare": "node scripts/prepare-test-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "pg": "8.16.3"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.23.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
